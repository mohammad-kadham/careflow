# Copy to .env and replace this value with a randomly generated secret.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret
NODE_ENV=development
# On a server behind a reverse proxy, set HOST=127.0.0.1.
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=careflow
DB_PASSWORD=replace-with-your-database-password
DB_NAME=main

# Required for new-account verification and password reset emails through Brevo.
# Use an API key, not an SMTP key. Never put this key in frontend/VITE variables.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CareFlow
APP_URL=http://localhost:5173

# Existing doctor user IDs allowed into the separate admin app. Empty denies everyone.
# Resolve IDs from your own account email in the database; never use a VITE variable.
ADMIN_USER_IDS=
